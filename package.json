{
  "name": "du-menu-scan",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev -w @du-menu-scan/web --if-present",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run check:i18n && npm run test:backend && npm run test --workspaces --if-present",
    "test:backend": "vitest run directus --exclude \".claude/**\" --exclude \"**/node_modules/**\"",
    "check:i18n": "node scripts/check-i18n.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "backend:up": "docker compose up -d",
    "backend:down": "docker compose down",
    "backend:reset": "docker compose down -v && docker compose up -d",
    "backend:schema:snapshot": "docker compose exec directus npx directus schema snapshot --yes /directus/snapshots/schema.yaml",
    "backend:schema:apply": "docker compose exec directus npx directus schema apply --yes /directus/snapshots/schema.yaml && docker compose restart directus",
    "backend:permissions": "node --env-file-if-exists=.env directus/scripts/create-permissions.mjs",
    "backend:seed": "node --env-file-if-exists=.env directus/scripts/import-seed.mjs",
    "qr": "node directus/scripts/generate-qr.mjs",
    "backend:flows": "node --env-file-if-exists=.env directus/scripts/create-flows.mjs",
    "backend:dashboard": "node --env-file-if-exists=.env directus/scripts/create-dashboard.mjs",
    "backend:verify:photos": "node --env-file-if-exists=.env directus/scripts/verify-public-photos.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^10.15.0",
    "jsqr": "^1.4.0",
    "pdfkit": "^0.21.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.10.1",
    "qrcode": "^1.5.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
