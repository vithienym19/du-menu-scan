# Copy to .env and replace every CHANGE_ME. Never commit .env.
# Generate secrets: openssl rand -base64 32   (see directus/README.md)

# --- PostgreSQL ---
DB_DATABASE=directus
DB_USER=directus
DB_PASSWORD=CHANGE_ME_db_password
# Host port for postgres (bound to 127.0.0.1 only)
DB_PORT_HOST=5432

# --- Directus ---
# Signs access tokens; use a long random string
SECRET=CHANGE_ME_random_32_plus_chars
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_admin_password
DIRECTUS_PORT=8055
PUBLIC_URL=http://localhost:8055

# Allowed browser origin for the web app (Vite dev server)
CORS_ORIGIN=http://localhost:5173

# Dev convenience; set to false on staging/production
EXTENSIONS_AUTO_RELOAD=true
